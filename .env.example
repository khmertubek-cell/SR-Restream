# DNS A record for this hostname must point to your VPS public IPv4.
DOMAIN=relay.example.com
PORT=5081
ADMIN_USER=admin
# Replace with a long, unique password before starting.
ADMIN_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
# Public URL used in generated M3U8 links. Must match DOMAIN.
PUBLIC_BASE_URL=https://relay.example.com
